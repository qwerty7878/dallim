            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="6" android:startY="65" android:endX="96" android:endY="14" android:startColor="#FF3558C8" android:endColor="#FF3558C8" />
            </aapt:attr>
        </path>

        <!-- 레이스 스티치 -->
        <path
            android:pathData="M47,30 L53,36 M52,26 L58,32 M57,23 L63,29"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="6" android:startY="65" android:endX="96" android:endY="14" android:startColor="#FF3558C8" android:endColor="#FF3558C8" />
            </aapt:attr>
        </path>

        <!-- 힐 풀탭 고리 -->
        <path
            android:pathData="M88,15 C91,12 94,13 94,17"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="6" android:startY="65" android:endX="96" android:endY="14" android:startColor="#FF3558C8" android:endColor="#FF3558C8" />
            </aapt:attr>
        </path>

        <!-- 위치 핀 (뒤꿈치 봉우리 쪽으로 당겨 0.7배 축소 — 세이프존 확보) -->
        <path
            android:pathData="M84,13.6 C88.2,13.6 91.7,17.1 91.7,21.3 C91.7,26.9 86.1,33.2 84,36 C81.9,33.2 76.3,26.9 76.3,21.3 C76.3,17.1 79.8,13.6 84,13.6 Z
                               M84,16.4 C86.1,16.4 87.85,18.15 87.85,20.25 C87.85,22.35 86.1,24.1 84,24.1 C81.9,24.1 80.15,22.35 80.15,20.25 C80.15,18.15 81.9,16.4 84,16.4 Z"
            android:fillType="evenOdd">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="76" android:startY="36" android:endX="92" android:endY="14" android:startColor="#FF3558C8" android:endColor="#FF3558C8" />
            </aapt:attr>
        </path>
    </group>
</vector>
