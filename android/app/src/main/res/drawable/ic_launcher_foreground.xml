            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="6" android:startY="65" android:endX="96" android:endY="14" android:startColor="#FF3558C8" android:endColor="#FF3558C8" />
            </aapt:attr>
        </path>

        <!-- 아웃솔 안쪽 심선 -->
        <path
