<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer. Approximates the signature brand gradient
  (docs/03-design-system.md 1.2: GradientStart #4A3AFF -> GradientEnd #FF6B4A),
  one of the 4 spots the design system allows a gradient (앱 아이콘).

  Hex values are copied verbatim from DallimColors (core-ui) — this is a raw
  Android resource (not Compose UI code) so it cannot reference the Kotlin
  token object directly; docs/04-ui-guide.md §10's "no hardcoded Color()" rule
  targets Compose screens, not XML icon resources.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF4A3AFF"
                android:endColor="#FFFF6B4A" />
        </aapt:attr>
    </path>
</vector>
