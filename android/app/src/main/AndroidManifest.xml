<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S-05/S-20 위치 권한. 백그라운드 위치 권한은 온보딩에서 요청하지 않고 S-20에서
         최초 요청한다 (docs/01-feature-spec.md 1.1 핵심 비기능 요구사항). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 걸음수 수집(StepCounterTracker, 2026-09-06 SPEC 편입). 이 권한을 얻기 위한 별도 요청
         UI/다이얼로그는 만들지 않는다 — 시스템 설정 등으로 이미 허용돼 있을 때만 사용하고,
         없으면 StepCounterTracker가 조용히 null로 폴백한다. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:name=".DallimApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dallim">

        <!-- S-16/S-21 네이버맵 SDK Client ID. local.properties의 NAVER_MAP_CLIENT_ID를
             app/build.gradle.kts가 manifestPlaceholders["naverMapClientId"]로 주입한다.
             값이 비어있으면(NCP Client ID 미발급 상태) core-ui의 지도 컴포넌트는 애초에 생성되지
             않고 BuildConfig.NAVER_MAP_CLIENT_ID_CONFIGURED 분기로 기존 Canvas 폴백을 사용하므로
             빈 문자열이어도 크래시하지 않는다. -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverMapClientId}" />

        <!-- S-56 홈 네이티브 광고 배너용 AdMob App ID. app/build.gradle.kts가 local.properties의
             ADMOB_APP_ID를 읽어 manifestPlaceholders["admobAppId"]로 주입하고, 값이 없으면 구글
             공식 테스트 App ID로 폴백한다 — 실제 배포 전 반드시 진짜 App ID로 교체해야 한다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dallim">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S-21 GPS 트래킹 파이프라인 (docs/01-feature-spec.md §1.3) — 화면 OFF/백그라운드에서도
             위치 수집을 유지하는 ForegroundService. -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 폰 시스템 푸시 (docs/01-feature-spec.md §1.7 2단계, docs/02-api-spec.md 10장). -->
        <service
            android:name=".push.DallimFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- S-26 공유 카드: Canvas로 합성한 Bitmap을 ShareSheet로 넘길 때 파일 URI를 제공. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hilt가 WorkManager를 직접 초기화(HiltWorkerFactory)하므로 기본 WorkManagerInitializer는
             끈다 — DallimApplication의 Configuration.Provider 구현 참고. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
